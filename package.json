{
  "name": "orionpax-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "tsx mock-server/index.ts",
    "dev:all": "concurrently -n mock,web -c magenta,cyan \"npm:mock\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
