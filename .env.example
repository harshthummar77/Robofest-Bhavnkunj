# OrionPax — rover node addresses.
#
# These seed the node registry, which is the ONLY place an address lives
# (see PROJECT_CONTEXT.md §12.1). Copy to `.env.local` and point them at the
# real rover network. Addresses can also be edited at runtime in the
# dashboard's Settings page, which overrides these.
#
# The defaults mirror the hardware split in §11: one Raspberry Pi 5 and two
# ESP32s. Any other split works — the dashboard routes each value by what it
# is, not by which host sent it, so one address or six both work.

# Raspberry Pi 5 — Pi Camera 3 detections, MLX90640 thermal frames, AI state
VITE_NODE_PI=http://192.168.1.50:8000

# ESP32 A — BME280 climate, MQ-2 / MQ-135 gas
VITE_NODE_ESP32_A=http://192.168.1.51

# ESP32 B — MPU6050, TF-Luna, GPS NEO-6M, FS-i6 iBUS link, drive, battery
VITE_NODE_ESP32_B=http://192.168.1.52

# Every node must allow this dashboard's origin via Access-Control-Allow-Origin,
# and all nodes must share one scheme: an HTTPS dashboard cannot read HTTP nodes.
#
# To try the real data path without hardware, run `npm run mock` and point the
# three nodes at http://localhost:7001 /telemetry, http://localhost:7002
# /api/sensors and http://localhost:7003 /api/status. For a dashboard with no
# network at all, use the Mock data switch instead.
